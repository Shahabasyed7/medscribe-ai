# MedScribe AI Environment Configuration (Placeholders)
# Copy this to .env for local development or set these variables in your hosting provider's dashboard (e.g. Render)

# Provider selection: 'gemini' or 'openai' (default: gemini)
LLM_PROVIDER=gemini

# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI or OpenAI-compatible (Ollama, vLLM, etc.) configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ASR Configuration
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma separated list of production frontend URLs)
# e.g. https://medscribe-ai.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://localhost:5173
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
