# Frontend Environment Configuration (Placeholders)
# Copy to .env.production or configure in Vercel Project Settings

# Production backend HTTP API base URL (e.g. https://medscribe-backend.onrender.com)
# Leave empty for local development to use the Vite proxy
VITE_API_BASE_URL=

# Production backend WebSocket base URL (e.g. wss://medscribe-backend.onrender.com)
# Leave empty for local development to use the current host
VITE_WS_BASE_URL=
